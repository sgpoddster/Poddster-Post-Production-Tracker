# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — used only by server-side ingest endpoint (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Ingest API Key ────────────────────────────────────────────────────────────
# Secret shared between this app and the GAS script.
# Generate any random string, e.g: openssl rand -hex 32
INGEST_API_KEY=your-random-secret-here

# ── App URL ───────────────────────────────────────────────────────────────────
# Set to your Vercel deployment URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
